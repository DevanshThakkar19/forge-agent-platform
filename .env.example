# Local defaults. Copy to .env at the repo root. Do not commit .env.
# The Week 1 API key is a dev placeholder. Change it before any shared deploy.

FORGE_API_KEY=dev-api-key
FORGE_DATABASE_URL=postgresql://forge:forge@localhost:5432/forge
# Paths are relative to the API working directory. make run uses backend/.
FORGE_SANDBOX_ROOT=var/sandbox
FORGE_CORPUS_DIR=corpus
FORGE_TOOL_TRANSPORT=stdio
FORGE_LOG_LEVEL=INFO
FORGE_MAX_GRAPH_STEPS=5
FORGE_TOOL_TIMEOUT_S=5
FORGE_HOST=127.0.0.1
FORGE_PORT=8000
# Relative to the API working directory. make run uses backend/.
# FORGE_BASELINE_PATH=evals/baselines/current.json
# keyword is the eval path. local asks a free Ollama model which lookups to open.
# FORGE_PLANNER=keyword
# FORGE_OLLAMA_URL=http://127.0.0.1:11434
# FORGE_OLLAMA_MODEL=mistral

# Paid search keys are not used. The web tool is a local fixture.
